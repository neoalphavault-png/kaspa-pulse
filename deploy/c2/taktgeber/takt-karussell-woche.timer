[Unit]
Description=Kaspa Pulse Takt, Karussell Woche, posten Mo 19:00 Berlin

[Timer]
Unit=takt@karussell-woche.service
# Montags 19:00 nach dem Daten-Update (Ben, 23.11.2026). Am Sa 21.11. zeigte
# das Karussell noch die Vorwoche. Bis dahin Sa 13:00.
OnCalendar=Mon *-*-* 19:00:00 Europe/Berlin
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
