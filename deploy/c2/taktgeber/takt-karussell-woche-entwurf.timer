[Unit]
Description=Kaspa Pulse Takt, Karussell Woche, Entwurf Mo 18:50 Berlin fuer 19:00

[Timer]
Unit=takt@karussell-woche-entwurf.service
# Montags nach dem Daten-Update der Weekly Numbers (takt-weeklynumbers, 18:40),
# zehn Minuten vor dem Post (Ben, 23.11.2026). Bis dahin Sa 11:00.
OnCalendar=Mon *-*-* 18:50:00 Europe/Berlin
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
